# Path to the piper executable. After `pip install piper-tts`, `which piper` shows it.
# Leave as just "piper" if it's on $PATH.
PIPER_BIN=piper

# Absolute or relative path to the Piper voice model (.onnx). The matching
# .onnx.json file MUST live next to it (Piper auto-discovers it).
PIPER_MODEL=./models/en_US-amy-medium.onnx

# Max upload size in megabytes. Requests above this are rejected with 413.
MAX_UPLOAD_MB=5

# Max number of characters of extracted text to send to Piper. Keeps synthesis
# bounded so a user can't accidentally generate a 30-minute clip from a novel.
MAX_TEXT_CHARS=10000
